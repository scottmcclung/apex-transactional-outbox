-- allium: 3
-- http-relay-client.allium

-- Scope: the generic HTTP relay client that ships with the outbox framework.
-- It delivers one message to one subscriber as a single HTTP request and
-- reports whether the subscriber accepted it.
-- Includes: HttpRelaySettings, HttpExchange, the success and failure outcomes
--   reported back to the framework
-- Excludes:
--   - Outbox lifecycle: fan-out, retries, backoff, dead-lettering, message
--     groups, time-to-live (transactional-outbox.allium)
--   - Message resolution (the client receives the resolved payload, if any)
--   - Credential storage and placeholder substitution in the endpoint and
--     headers (platform feature)
--   - Transport concerns: TLS, redirects
--   - The Case example under example/

use "./transactional-outbox.allium" as outbox

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The system that receives messages for a subscription.
external entity SubscriberEndpoint {}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value HttpHeader {
    name: String
    content: String
}

-- Per-subscription settings, read from the subscription's client settings.
value HttpRelaySettings {
    endpoint: String?
    method: String?
    timeout: Duration?
    headers: Set<HttpHeader>

    -- The endpoint, the method and the timeout are required, and none has
    -- a default. The endpoint must be a web address or a reference to a
    -- stored credential. The method must be an HTTP method name. The
    -- timeout is how long to wait for the subscriber to answer. Headers
    -- are optional, but when given they must be name and value pairs.
    is_valid:
        endpoint != null and is_endpoint_format(endpoint)
        and method != null and is_http_method(method)
        and timeout != null and timeout > 0.seconds and timeout <= config.longest_allowed_timeout
        and are_name_value_pairs(headers)
}

value HttpResponse {
    status_code: Integer
    status: String
    body: String
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract HttpEndpoint {
    exchange: (endpoint: String, method: String, headers: Set<HttpHeader>, body: String, timeout: Duration) -> HttpResponse

    @invariant OneRequestPerAttempt
        -- The client makes exactly one request per relay attempt. It never
        -- retries on its own. Retrying is the framework's decision.
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- The single request made for a relay attempt, and what came back.
entity HttpExchange {
    attempt: outbox/RelayAttempt
    endpoint: String
    method: String
    headers: Set<HttpHeader>
    body: String
    timeout: Duration

    -- Sent as a request header, in addition to the configured headers.
    idempotency_key: String

    status: sent | accepted | rejected | unanswered

    -- Kept so that after-relay actions can inspect what the subscriber said.
    response: HttpResponse when status = accepted | rejected

    transitions status {
        sent -> accepted
        sent -> rejected
        sent -> unanswered
        terminal: accepted, rejected, unanswered
    }
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- The relay client name a subscription uses to select this client.
    client_name: String = "TB_GenericHttpRelayClient"

    -- Only a response with a status code in this range means the subscriber
    -- accepted the message.
    -- The name of the request header that carries the idempotency key.
    idempotency_header: String = "Idempotency-Key"

    -- The longest wait the platform allows for one request.
    longest_allowed_timeout: Duration = 120.seconds

    lowest_accepted_status_code: Integer = 200
    highest_accepted_status_code: Integer = 299
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule SendMessageOverHttp {
    when: outbox/SendRequested(attempt)

    requires: attempt.outbox.subscription.relay_client = config.client_name

    -- http_settings reads the endpoint, method and headers from the
    -- subscription's client settings.
    let settings = http_settings(attempt.outbox.subscription.client_settings)

    requires: settings.is_valid

    -- The resolved payload is preferred over the raw one. Text is sent
    -- unchanged; any other structure is sent as its JSON encoding. A message
    -- with neither is sent with an empty body.
    let body =
        if attempt.resolved_payload != null: as_body_text(attempt.resolved_payload)
        else: attempt.outbox.message.payload ?? ""

    ensures: HttpExchange.created(
        attempt: attempt,
        endpoint: settings.endpoint,
        method: settings.method,
        headers: settings.headers,
        body: body,
        timeout: settings.timeout,
        idempotency_key: attempt.outbox.idempotency_key,
        status: sent
    )
}

rule RejectInvalidSettings {
    when: outbox/SendRequested(attempt)

    requires: attempt.outbox.subscription.relay_client = config.client_name

    let settings = http_settings(attempt.outbox.subscription.client_settings)

    requires: not settings.is_valid

    -- No request is made. The attempt fails like any other, so the outbox
    -- retries and then dead-letters unless the settings are corrected.
    -- settings_problem names the setting that is missing or malformed.
    ensures: outbox/RelayFailed(attempt: attempt, reason: settings_problem(settings))
}

rule SubscriberAcceptsMessage {
    when: HttpResponseReceived(exchange, response)

    requires: exchange.status = sent
    requires:
        response.status_code >= config.lowest_accepted_status_code
        and response.status_code <= config.highest_accepted_status_code

    ensures: exchange.status = accepted
    ensures: exchange.response = response
    ensures: outbox/RelaySucceeded(attempt: exchange.attempt)
}

rule SubscriberRejectsMessage {
    when: HttpResponseReceived(exchange, response)

    requires: exchange.status = sent
    requires:
        response.status_code < config.lowest_accepted_status_code
        or response.status_code > config.highest_accepted_status_code

    ensures: exchange.status = rejected
    ensures: exchange.response = response

    -- rejection_reason gives the status code and the response body, so
    -- that whoever reviews the outbox can see why the subscriber refused.
    ensures: outbox/RelayFailed(attempt: exchange.attempt, reason: rejection_reason(response))
}

rule SubscriberDoesNotAnswer {
    -- Covers a subscriber that cannot be reached and one that does not
    -- answer within the timeout.
    when: HttpRequestFailed(exchange, reason)

    requires: exchange.status = sent

    ensures: exchange.status = unanswered
    ensures: outbox/RelayFailed(attempt: exchange.attempt, reason: reason)
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface RelayRequests {
    facing _: outbox/RelayClientImplementation

    contracts:
        fulfils outbox/RelayClient

    @guarantee OutcomeAlwaysReported
        -- Every send request ends in exactly one of RelaySucceeded or
        -- RelayFailed. The client never reports success without a response
        -- from the subscriber.

    @guarantee SettingsCheckedBeforeSending
        -- The client checks the subscription's settings before it makes a
        -- request. Settings it cannot use fail the attempt without
        -- contacting the subscriber.

    @guarantee ValidationMatchesSending
        -- validate_settings rejects exactly the settings that would fail
        -- this check: a missing or malformed endpoint, a missing or
        -- malformed method, a missing or out-of-range timeout, or headers
        -- that are not name and value pairs.

    @guarantee AttemptIsTraceable
        -- The attempt's log records the method, endpoint and body that were
        -- sent and the status code that came back. On success it also
        -- records the response body.
}

surface SubscriberDelivery {
    facing _: SubscriberEndpoint

    contracts:
        demands HttpEndpoint

    provides:
        HttpResponseReceived(exchange, response)
        HttpRequestFailed(exchange, reason)

    @guarantee RepeatsAreRecognisable
        -- Every request carries the outbox's idempotency key in the
        -- idempotency header. The key is the same on every attempt for
        -- that outbox, and a header of the same name in the subscription's
        -- settings does not replace it.
}
